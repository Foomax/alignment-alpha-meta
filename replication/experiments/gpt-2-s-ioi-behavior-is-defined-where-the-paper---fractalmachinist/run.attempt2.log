import numpy as np
from scipy import stats

# Statistical tests comparing control vs test paired samples (uses variables already in notebook)

ctrl = ctrl_diffs.cpu().numpy()
test = test_diffs.cpu().numpy()
diff = ctrl - test

# Paired t-test
t_stat, p_t = stats.ttest_rel(ctrl, test)

# Wilcoxon signed-rank test (paired, nonparametric)
try:
    w_stat, p_w = stats.wilcoxon(ctrl, test)
except Exception as e:
    w_stat, p_w = None, None

# Two-sample KS test (distribution-level)
ks_stat, p_ks = stats.ks_2samp(ctrl, test)

# Mann-Whitney U (unpaired, distribution shift)
u_stat, p_u = stats.mannwhitneyu(ctrl, test, alternative="two-sided")

# Paired permutation (sign-flip) test for mean difference
rng = np.random.default_rng(SEED)
n_perm = 10000
obs = diff.mean()
perms = np.empty(n_perm)
for i in range(n_perm):
    signs = rng.choice([-1, 1], size=diff.size)
    perms[i] = (diff * signs).mean()
p_perm = (np.abs(perms) >= abs(obs)).sum() / n_perm

# Effect size (paired Cohen's d)
cohen_d = diff.mean() / diff.std(ddof=1)

# Print concise results
print(f"n = {ctrl.size}")
print(f"paired t-test: t = {t_stat:.4f}, p = {p_t:.4g}")
if w_stat is not None:
    print(f"wilcoxon signed-rank: W = {w_stat:.4f}, p = {p_w:.4g}")
else:
    print("wilcoxon signed-rank: failed (check zero differences or ties)")
print(f"KS two-sample: D = {ks_stat:.4f}, p = {p_ks:.4g}")
print(f"Mann-Whitney U: U = {u_stat:.4f}, p = {p_u:.4g}")
print(f"paired permutation (sign-flip, n={n_perm}): mean_diff = {obs:.4f}, p = {p_perm:.4g}")
print(f"mean diff = {diff.mean():.4f}, std diff = {diff.std(ddof=1):.4f}, Cohen's d = {cohen_d:.4f}")
